  {
    "funcion": "trg_reevaluate_role_from_activity",
    "definicion": "CREATE OR REPLACE FUNCTION public.trg_reevaluate_role_from_activity()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_act_id  UUID;\r\n  v_prof_id UUID;\r\nBEGIN\r\n  IF pg_trigger_depth() > 1 THEN\r\n    RETURN NULL;\r\n  END IF;\r\n\r\n  v_act_id := COALESCE(NEW.id, OLD.id);\r\n\r\n  -- Reevaluar profesor anterior y/o nuevo\r\n  FOR v_prof_id IN\r\n    SELECT DISTINCT p.id\r\n    FROM public.profiles p\r\n    LEFT JOIN public.teachers t ON t.id IN (OLD.teacher_id, NEW.teacher_id)\r\n    WHERE p.teacher_id IN (OLD.teacher_id, NEW.teacher_id)\r\n       OR (\r\n         t.email IS NOT NULL\r\n         AND btrim(t.email) <> ''\r\n         AND lower(btrim(p.email)) = lower(btrim(t.email))\r\n       )\r\n  LOOP\r\n    PERFORM public.reevaluate_user_operational_role(v_prof_id);\r\n  END LOOP;\r\n\r\n  -- Si cambió active o se eliminó el taller, reevaluar también alumnos inscritos\r\n  IF TG_OP = 'DELETE' OR (TG_OP = 'UPDATE' AND COALESCE(OLD.active, TRUE) IS DISTINCT FROM COALESCE(NEW.active, TRUE)) THEN\r\n    FOR v_prof_id IN\r\n      SELECT DISTINCT p.id\r\n      FROM public.student_enrollments se\r\n      JOIN public.students s ON s.id = se.student_id\r\n      JOIN public.profiles p\r\n        ON p.student_id = s.id\r\n        OR (s.profile_id IS NOT NULL AND p.id = s.profile_id)\r\n        OR (\r\n          s.email IS NOT NULL\r\n          AND btrim(s.email) <> ''\r\n          AND lower(btrim(p.email)) = lower(btrim(s.email))\r\n        )\r\n      WHERE se.activity_id = v_act_id\r\n    LOOP\r\n      PERFORM public.reevaluate_user_operational_role(v_prof_id);\r\n    END LOOP;\r\n  END IF;\r\n\r\n  RETURN NULL;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "trg_reevaluate_role_from_enrollment",
    "definicion": "CREATE OR REPLACE FUNCTION public.trg_reevaluate_role_from_enrollment()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_student_id UUID;\r\n  v_prof_id    UUID;\r\nBEGIN\r\n  IF pg_trigger_depth() > 1 THEN\r\n    RETURN NULL;\r\n  END IF;\r\n\r\n  v_student_id := COALESCE(NEW.student_id, OLD.student_id);\r\n  IF v_student_id IS NULL THEN\r\n    RETURN NULL;\r\n  END IF;\r\n\r\n  FOR v_prof_id IN\r\n    SELECT DISTINCT p.id\r\n    FROM public.profiles p\r\n    LEFT JOIN public.students s ON s.id = v_student_id\r\n    WHERE p.student_id = v_student_id\r\n       OR (s.profile_id IS NOT NULL AND p.id = s.profile_id)\r\n       OR (\r\n         s.email IS NOT NULL\r\n         AND btrim(s.email) <> ''\r\n         AND lower(btrim(p.email)) = lower(btrim(s.email))\r\n       )\r\n  LOOP\r\n    PERFORM public.reevaluate_user_operational_role(v_prof_id);\r\n  END LOOP;\r\n\r\n  RETURN NULL;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "trg_sync_profiles_for_student",
    "definicion": "CREATE OR REPLACE FUNCTION public.trg_sync_profiles_for_student(p_student_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_email text;\r\n  v_profile_id uuid;\r\n  v_rec record;\r\nBEGIN\r\n  SELECT email, profile_id INTO v_email, v_profile_id\r\n  FROM public.students WHERE id = p_student_id;\r\n\r\n  FOR v_rec IN\r\n    SELECT DISTINCT id FROM public.profiles\r\n    WHERE student_id = p_student_id\r\n       OR (v_profile_id IS NOT NULL AND id = v_profile_id)\r\n       OR (coalesce(trim(v_email), '') <> '' AND lower(trim(email)) = lower(trim(v_email)))\r\n  LOOP\r\n    PERFORM public.sync_profile_role_and_access(v_rec.id);\r\n  END LOOP;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "trg_sync_profiles_for_teacher",
    "definicion": "CREATE OR REPLACE FUNCTION public.trg_sync_profiles_for_teacher(p_teacher_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_email text;\r\n  v_rec record;\r\nBEGIN\r\n  SELECT email INTO v_email FROM public.teachers WHERE id = p_teacher_id;\r\n\r\n  FOR v_rec IN\r\n    SELECT DISTINCT id FROM public.profiles\r\n    WHERE teacher_id = p_teacher_id\r\n       OR (coalesce(trim(v_email), '') <> '' AND lower(trim(email)) = lower(trim(v_email)))\r\n  LOOP\r\n    PERFORM public.sync_profile_role_and_access(v_rec.id);\r\n  END LOOP;\r\nEND;\r\n$function$\n"
