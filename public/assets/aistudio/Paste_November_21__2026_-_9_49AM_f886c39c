  {
    "funcion": "quick_create_and_enroll_student",
    "definicion": "CREATE OR REPLACE FUNCTION public.quick_create_and_enroll_student(p_name text, p_email text, p_phone text DEFAULT ''::text, p_notes text DEFAULT ''::text, p_activity_id uuid DEFAULT NULL::uuid, p_custom_price numeric DEFAULT NULL::numeric)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_uid uuid := auth.uid();\r\n  v_role text;\r\n  v_student_id uuid;\r\n  v_clean_email text := lower(trim(coalesce(p_email, '')));\r\n  v_today date := current_date;\r\nBEGIN\r\n  IF v_uid IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Authentication required');\r\n  END IF;\r\n\r\n  SELECT role INTO v_role FROM public.profiles WHERE id = v_uid AND active = true;\r\n  IF v_role NOT IN ('admin', 'superadmin', 'teacher', 'teacher_student') THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Insufficient permissions');\r\n  END IF;\r\n\r\n  IF v_clean_email <> '' THEN\r\n    SELECT id INTO v_student_id\r\n    FROM public.students\r\n    WHERE lower(email) = v_clean_email\r\n    LIMIT 1;\r\n  END IF;\r\n\r\n  IF v_student_id IS NULL THEN\r\n    INSERT INTO public.students (\r\n      name, email, phone, notes, active, status, validation_status,\r\n      member_type, registered_by, registered_at\r\n    )\r\n    VALUES (\r\n      trim(p_name),\r\n      CASE WHEN v_clean_email = '' THEN NULL ELSE v_clean_email END,\r\n      coalesce(trim(p_phone), ''),\r\n      coalesce(trim(p_notes), ''),\r\n      true,\r\n      'pending_validation',\r\n      'pending',\r\n      'socio',\r\n      v_uid,\r\n      now()\r\n    )\r\n    RETURNING id INTO v_student_id;\r\n  END IF;\r\n\r\n  IF p_activity_id IS NOT NULL THEN\r\n    INSERT INTO public.student_enrollments (\r\n      student_id, activity_id, custom_price, enrolled_since, start_date,\r\n      active, status, deleted_at, ended_at\r\n    )\r\n    VALUES (\r\n      v_student_id, p_activity_id, p_custom_price, v_today, v_today,\r\n      true, 'active', NULL, NULL\r\n    )\r\n    ON CONFLICT (student_id, activity_id) DO UPDATE\r\n      SET active = true,\r\n          status = 'active',\r\n          custom_price = coalesce(EXCLUDED.custom_price, public.student_enrollments.custom_price),\r\n          deleted_at = NULL,\r\n          ended_at = NULL,\r\n          drop_requested_at = NULL,\r\n          drop_reason = NULL;\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object('success', true, 'student_id', v_student_id);\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "reevaluate_user_operational_role",
    "definicion": "CREATE OR REPLACE FUNCTION public.reevaluate_user_operational_role(p_profile_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_prof public.profiles%ROWTYPE;\r\n  v_has_student boolean := false;\r\n  v_has_teacher boolean := false;\r\n  v_is_socio boolean := false;\r\n  v_op_role text := 'vacio';\r\n  v_next_role text;\r\n  v_next_access boolean;\r\nBEGIN\r\n  SELECT * INTO v_prof FROM public.profiles WHERE id = p_profile_id;\r\n  IF NOT FOUND THEN\r\n    RETURN;\r\n  END IF;\r\n\r\n  -- Check active student enrollments in public.student_enrollments\r\n  IF v_prof.student_id IS NOT NULL THEN\r\n    SELECT EXISTS (\r\n      SELECT 1\r\n      FROM public.student_enrollments e\r\n      JOIN public.activities a ON a.id = e.activity_id\r\n      WHERE e.student_id = v_prof.student_id\r\n        AND COALESCE(e.status, 'active') IN ('active', 'approved', 'pending_unenroll', 'pending_withdrawal')\r\n        AND COALESCE(a.status, 'active') = 'active'\r\n    ) INTO v_has_student;\r\n  END IF;\r\n\r\n  -- Check active teacher workshops\r\n  IF v_prof.teacher_id IS NOT NULL THEN\r\n    SELECT EXISTS (\r\n      SELECT 1\r\n      FROM public.activities a\r\n      WHERE a.teacher_id = v_prof.teacher_id\r\n        AND COALESCE(a.status, 'active') = 'active'\r\n    ) INTO v_has_teacher;\r\n  END IF;\r\n\r\n  v_is_socio := COALESCE(v_prof.is_socio, v_prof.member_type = 'socio', false);\r\n\r\n  IF v_has_teacher AND v_has_student THEN\r\n    v_op_role := 'hibrido';\r\n  ELSIF v_has_student THEN\r\n    v_op_role := 'alumno';\r\n  ELSIF v_has_teacher THEN\r\n    v_op_role := 'profesor';\r\n  ELSE\r\n    v_op_role := 'vacio';\r\n  END IF;\r\n\r\n  IF lower(trim(COALESCE(v_prof.email, ''))) = 'cristino.conde@actriskell.org' OR v_prof.role = 'Admin' THEN\r\n    v_next_role := 'Admin';\r\n    v_next_access := CASE\r\n      WHEN lower(trim(COALESCE(v_prof.email, ''))) = 'cristino.conde@actriskell.org' THEN true\r\n      ELSE COALESCE(v_prof.access, true)\r\n    END;\r\n  ELSIF v_op_role = 'hibrido' THEN\r\n    v_next_role := 'Híbrido';\r\n    v_next_access := true;\r\n  ELSIF v_op_role = 'alumno' THEN\r\n    v_next_role := 'Alumno';\r\n    v_next_access := true;\r\n  ELSIF v_op_role = 'profesor' THEN\r\n    v_next_role := 'Monitor';\r\n    v_next_access := true;\r\n  ELSIF v_is_socio THEN\r\n    v_next_role := 'Socio';\r\n    v_next_access := COALESCE(v_prof.access, true);\r\n  ELSE\r\n    v_next_role := COALESCE(NULLIF(v_prof.role, ''), 'Socio');\r\n    v_next_access := false;\r\n  END IF;\r\n\r\n  UPDATE public.profiles\r\n  SET\r\n    operational_role = v_op_role,\r\n    role = v_next_role,\r\n    access = v_next_access,\r\n    active = v_next_access,\r\n    is_socio = v_is_socio\r\n  WHERE id = p_profile_id;\r\n\r\n  IF v_next_access THEN\r\n    UPDATE public.profiles\r\n    SET end_date = NULL\r\n    WHERE id = p_profile_id AND end_date IS NOT NULL;\r\n  ELSE\r\n    UPDATE public.profiles\r\n    SET end_date = CURRENT_DATE\r\n    WHERE id = p_profile_id AND NULLIF(end_date::text, '') IS NULL;\r\n  END IF;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "reject_association_withdrawal",
    "definicion": "CREATE OR REPLACE FUNCTION public.reject_association_withdrawal(p_request_id uuid, p_notes text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_admin_id uuid := auth.uid();\r\n  v_admin_email text := lower(trim(COALESCE(auth.jwt() ->> 'email', '')));\r\n  v_is_admin boolean := false;\r\n  v_now timestamptz := now();\r\nBEGIN\r\n  SELECT EXISTS (\r\n    SELECT 1\r\n    FROM public.profiles p\r\n    WHERE (p.id = v_admin_id OR (v_admin_email <> '' AND lower(trim(p.email)) = v_admin_email))\r\n      AND COALESCE(p.access, true) = true\r\n      AND p.role = 'Admin'\r\n  ) INTO v_is_admin;\r\n\r\n  IF NOT v_is_admin THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Solo un Administrador activo puede rechazar la solicitud.');\r\n  END IF;\r\n\r\n  UPDATE public.membership_withdrawal_requests\r\n  SET status = 'rejected',\r\n      debts_checked = false,\r\n      materials_checked = false,\r\n      resolution_notes = NULLIF(trim(p_notes), ''),\r\n      resolved_by = v_admin_id,\r\n      resolved_at = v_now,\r\n      updated_at = v_now\r\n  WHERE id = p_request_id\r\n    AND status = 'pending';\r\n\r\n  IF NOT FOUND THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Solicitud no encontrada o ya procesada.');\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object('success', true, 'request_id', p_request_id);\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "request_activity_unenrollment",
    "definicion": "CREATE OR REPLACE FUNCTION public.request_activity_unenrollment(p_activity_id uuid, p_reason text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_uid UUID := auth.uid();\r\n  v_student_id UUID;\r\n  v_updated_id UUID;\r\nBEGIN\r\n  IF v_uid IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'No hay sesión autenticada.');\r\n  END IF;\r\n\r\n  SELECT s.id INTO v_student_id\r\n  FROM public.profiles p\r\n  JOIN public.students s\r\n    ON s.id = p.student_id\r\n    OR s.profile_id = p.id\r\n    OR lower(trim(coalesce(s.email, ''))) = lower(trim(coalesce(p.email, '')))\r\n  WHERE p.id = v_uid\r\n    AND p.active IS DISTINCT FROM FALSE\r\n  LIMIT 1;\r\n\r\n  IF v_student_id IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'No se encontró la ficha de alumno vinculada.');\r\n  END IF;\r\n\r\n  UPDATE public.student_enrollments\r\n  SET status = 'pending_unenroll',\r\n      drop_requested_at = now(),\r\n      drop_reason = NULLIF(trim(coalesce(p_reason, '')), '')\r\n  WHERE student_id = v_student_id\r\n    AND activity_id = p_activity_id\r\n    AND active IS DISTINCT FROM FALSE\r\n    AND status IN ('active', 'pending_unenroll')\r\n  RETURNING id INTO v_updated_id;\r\n\r\n  IF v_updated_id IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'No existe una matrícula activa para solicitar baja.');\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object('success', true, 'enrollment_id', v_updated_id);\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "self_unenroll_from_activity",
    "definicion": "CREATE OR REPLACE FUNCTION public.self_unenroll_from_activity(p_activity_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_uid uuid := auth.uid();\r\n  v_email text;\r\n  v_student_id uuid;\r\nBEGIN\r\n  IF v_uid IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Authentication required');\r\n  END IF;\r\n\r\n  SELECT lower(email) INTO v_email FROM public.profiles WHERE id = v_uid AND active = true;\r\n  SELECT id INTO v_student_id FROM public.students WHERE lower(email) = v_email LIMIT 1;\r\n\r\n  IF v_student_id IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Student record not found');\r\n  END IF;\r\n\r\n  UPDATE public.student_enrollments\r\n  SET active = false,\r\n      status = 'inactive',\r\n      deleted_at = now(),\r\n      ended_at = current_date\r\n  WHERE student_id = v_student_id\r\n    AND activity_id = p_activity_id;\r\n\r\n  RETURN jsonb_build_object('success', true);\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "sync_profile_on_student_link",
    "definicion": "CREATE OR REPLACE FUNCTION public.sync_profile_on_student_link()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nBEGIN\r\n  IF NEW.profile_id IS NOT NULL THEN\r\n    UPDATE public.profiles\r\n    SET\r\n      student_id = NEW.id,\r\n      role = CASE\r\n        WHEN role = 'teacher' THEN 'teacher_student'\r\n        ELSE role\r\n      END,\r\n      updated_at = NOW()\r\n    WHERE id = NEW.profile_id;\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "sync_profile_role_and_access",
    "definicion": "CREATE OR REPLACE FUNCTION public.sync_profile_role_and_access(p_profile_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_prof public.profiles%ROWTYPE;\r\n  v_op_role public.operational_role_type;\r\n  v_is_socio boolean;\r\n  v_next_role text;\r\n  v_next_active boolean;\r\n  v_next_end_date date;\r\nBEGIN\r\n  SELECT * INTO v_prof FROM public.profiles WHERE id = p_profile_id;\r\n  IF NOT FOUND THEN\r\n    RETURN jsonb_build_object('updated', false, 'reason', 'profile_not_found');\r\n  END IF;\r\n\r\n  v_op_role := public.derive_user_operational_role(\r\n    v_prof.student_id,\r\n    v_prof.teacher_id,\r\n    v_prof.email,\r\n    v_prof.id\r\n  );\r\n  v_is_socio := coalesce(v_prof.is_socio, true);\r\n\r\n  IF v_prof.role IS NOT DISTINCT FROM 'admin'\r\n     OR lower(trim(coalesce(v_prof.email, ''))) = 'cristino.conde@actriskell.org' THEN\r\n    v_next_role := 'admin';\r\n    v_next_active := coalesce(v_prof.active, true);\r\n    v_next_end_date := CASE WHEN v_next_active THEN NULL ELSE coalesce(v_prof.end_date, current_date) END;\r\n  ELSE\r\n    CASE v_op_role\r\n      WHEN 'hibrido' THEN\r\n        v_next_role := 'teacher_student';\r\n        v_next_active := true;\r\n        v_next_end_date := NULL;\r\n      WHEN 'alumno' THEN\r\n        v_next_role := 'student';\r\n        v_next_active := true;\r\n        v_next_end_date := NULL;\r\n      WHEN 'profesor' THEN\r\n        v_next_role := 'teacher';\r\n        v_next_active := true;\r\n        v_next_end_date := NULL;\r\n      ELSE\r\n        IF v_is_socio THEN\r\n          v_next_role := 'socio';\r\n          v_next_active := true;\r\n          v_next_end_date := NULL;\r\n        ELSE\r\n          v_next_role := NULL;\r\n          v_next_active := false;\r\n          v_next_end_date := coalesce(v_prof.end_date, current_date);\r\n        END IF;\r\n    END CASE;\r\n  END IF;\r\n\r\n  -- Habilitar bandera local de transacción para el guard de profiles\r\n  PERFORM set_config('app.allow_profile_role_sync', 'on', true);\r\n\r\n  UPDATE public.profiles\r\n  SET\r\n    operational_role = v_op_role,\r\n    is_socio = v_is_socio,\r\n    role = v_next_role,\r\n    active = v_next_active,\r\n    end_date = v_next_end_date,\r\n    member_type = CASE\r\n      WHEN v_is_socio THEN 'socio'\r\n      WHEN v_op_role = 'profesor' THEN 'monitor_no_socio'\r\n      ELSE 'alumno_no_socio'\r\n    END\r\n  WHERE id = p_profile_id;\r\n\r\n  PERFORM set_config('app.allow_profile_role_sync', 'off', true);\r\n\r\n  IF v_prof.student_id IS NOT NULL THEN\r\n    IF v_op_role = 'vacio' AND v_is_socio THEN\r\n      UPDATE public.students\r\n      SET status = CASE WHEN status = 'inactive' THEN 'active' ELSE status END,\r\n          is_socio = true,\r\n          member_type = 'socio'\r\n      WHERE id = v_prof.student_id;\r\n    ELSIF v_op_role = 'vacio' AND NOT v_is_socio THEN\r\n      UPDATE public.students\r\n      SET is_socio = false,\r\n          member_type = 'alumno_no_socio'\r\n      WHERE id = v_prof.student_id;\r\n    END IF;\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object(\r\n    'profile_id', p_profile_id,\r\n    'operational_role', v_op_role,\r\n    'is_socio', v_is_socio,\r\n    'role', v_next_role,\r\n    'active', v_next_active\r\n  );\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "trg_fn_activities_auto_sync",
    "definicion": "CREATE OR REPLACE FUNCTION public.trg_fn_activities_auto_sync()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_act_id uuid := coalesce(NEW.id, OLD.id);\r\n  v_st record;\r\nBEGIN\r\n  IF pg_trigger_depth() > 1 THEN RETURN NULL; END IF;\r\n  IF TG_OP IN ('INSERT', 'UPDATE') AND NEW.teacher_id IS NOT NULL THEN\r\n    PERFORM public.trg_sync_profiles_for_teacher(NEW.teacher_id);\r\n  END IF;\r\n  IF TG_OP IN ('UPDATE', 'DELETE') AND OLD.teacher_id IS NOT NULL\r\n     AND (TG_OP = 'DELETE' OR OLD.teacher_id IS DISTINCT FROM NEW.teacher_id) THEN\r\n    PERFORM public.trg_sync_profiles_for_teacher(OLD.teacher_id);\r\n  END IF;\r\n  FOR v_st IN\r\n    SELECT DISTINCT student_id FROM public.student_enrollments WHERE activity_id = v_act_id\r\n  LOOP\r\n    PERFORM public.trg_sync_profiles_for_student(v_st.student_id);\r\n  END LOOP;\r\n  RETURN NULL;\r\nEND;\r\n$function$\n"
