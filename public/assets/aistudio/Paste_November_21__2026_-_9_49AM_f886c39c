  {
    "funcion": "moderate_activity_unenrollment",
    "definicion": "CREATE OR REPLACE FUNCTION public.moderate_activity_unenrollment(p_student_id uuid, p_activity_id uuid, p_approve boolean, p_debts_checked boolean DEFAULT false, p_materials_checked boolean DEFAULT false, p_notes text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_uid uuid := auth.uid();\r\n  v_role text;\r\nBEGIN\r\n  IF v_uid IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Authentication required');\r\n  END IF;\r\n\r\n  SELECT role INTO v_role FROM public.profiles WHERE id = v_uid AND active = true;\r\n  IF v_role NOT IN ('admin', 'superadmin', 'teacher', 'teacher_student') THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Insufficient permissions');\r\n  END IF;\r\n\r\n  IF p_approve THEN\r\n    UPDATE public.student_enrollments\r\n    SET active = false,\r\n        status = 'inactive',\r\n        deleted_at = now(),\r\n        ended_at = current_date,\r\n        drop_debts_checked = p_debts_checked,\r\n        drop_materials_checked = p_materials_checked,\r\n        drop_moderation_notes = p_notes,\r\n        drop_moderated_at = now(),\r\n        drop_moderated_by = v_uid\r\n    WHERE student_id = p_student_id\r\n      AND activity_id = p_activity_id;\r\n  ELSE\r\n    UPDATE public.student_enrollments\r\n    SET active = true,\r\n        status = 'active',\r\n        drop_requested_at = NULL,\r\n        drop_reason = NULL,\r\n        drop_moderation_notes = p_notes,\r\n        drop_moderated_at = now(),\r\n        drop_moderated_by = v_uid\r\n    WHERE student_id = p_student_id\r\n      AND activity_id = p_activity_id;\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object('success', true);\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "prevent_cancel_closed_class_absence",
    "definicion": "CREATE OR REPLACE FUNCTION public.prevent_cancel_closed_class_absence()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_is_closed boolean := false;\r\n  v_is_staff boolean := false;\r\nBEGIN\r\n  IF OLD.status IS DISTINCT FROM 'cancelled' AND NEW.status = 'cancelled' THEN\r\n    SELECT EXISTS (\r\n      SELECT 1\r\n      FROM public.profiles p\r\n      WHERE p.id = auth.uid()\r\n        AND lower(coalesce(p.role, '')) IN ('admin', 'monitor', 'híbrido', 'hibrido')\r\n    ) INTO v_is_staff;\r\n\r\n    SELECT coalesce(bool_or(cs.is_closed), false)\r\n      INTO v_is_closed\r\n      FROM public.class_sessions cs\r\n     WHERE cs.activity_id = OLD.activity_id\r\n       AND cs.date = OLD.session_date;\r\n\r\n    IF v_is_closed AND NOT v_is_staff THEN\r\n      RAISE EXCEPTION 'No se puede anular el aviso de ausencia porque la clase ya ha sido cerrada por el monitor.';\r\n    END IF;\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "prevent_profile_privilege_escalation",
    "definicion": "CREATE OR REPLACE FUNCTION public.prevent_profile_privilege_escalation()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  caller_role text;\r\nBEGIN\r\n  IF auth.uid() IS NULL THEN\r\n    RETURN NEW; -- Permite operaciones de servicio / SQL Editor\r\n  END IF;\r\n\r\n  SELECT role INTO caller_role FROM public.profiles WHERE id = auth.uid();\r\n\r\n  IF caller_role IS DISTINCT FROM 'admin' THEN\r\n    IF NEW.role IS DISTINCT FROM OLD.role\r\n       OR NEW.teacher_id IS DISTINCT FROM OLD.teacher_id\r\n       OR NEW.student_id IS DISTINCT FROM OLD.student_id THEN\r\n      RAISE EXCEPTION 'Solo la administración puede modificar el rol o los vínculos de perfil.';\r\n    END IF;\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
