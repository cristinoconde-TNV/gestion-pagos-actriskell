  {
    "funcion": "trg_fn_profiles_auto_sync",
    "definicion": "CREATE OR REPLACE FUNCTION public.trg_fn_profiles_auto_sync()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_op_role public.operational_role_type;\r\nBEGIN\r\n  IF pg_trigger_depth() > 1 THEN\r\n    RETURN NEW;\r\n  END IF;\r\n\r\n  IF TG_OP = 'INSERT' OR (\r\n    NEW.is_socio IS DISTINCT FROM OLD.is_socio\r\n    OR NEW.student_id IS DISTINCT FROM OLD.student_id\r\n    OR NEW.teacher_id IS DISTINCT FROM OLD.teacher_id\r\n  ) THEN\r\n    v_op_role := public.derive_user_operational_role(NEW.student_id, NEW.teacher_id, NEW.email, NEW.id);\r\n    NEW.operational_role := v_op_role;\r\n\r\n    IF NEW.role IS DISTINCT FROM 'admin'\r\n       AND lower(trim(COALESCE(NEW.email, ''))) <> 'cristino.conde@actriskell.org' THEN\r\n      CASE v_op_role\r\n        WHEN 'hibrido' THEN\r\n          NEW.role := 'hybrid';\r\n          NEW.active := true;\r\n          NEW.access := true;\r\n          NEW.end_date := NULL;\r\n        WHEN 'alumno' THEN\r\n          NEW.role := 'student';\r\n          NEW.active := true;\r\n          NEW.access := true;\r\n          NEW.end_date := NULL;\r\n        WHEN 'profesor' THEN\r\n          NEW.role := 'teacher';\r\n          NEW.active := true;\r\n          NEW.access := true;\r\n          NEW.end_date := NULL;\r\n        ELSE\r\n          NEW.role := COALESCE(NULLIF(NEW.role, ''), 'member');\r\n      END CASE;\r\n    END IF;\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
