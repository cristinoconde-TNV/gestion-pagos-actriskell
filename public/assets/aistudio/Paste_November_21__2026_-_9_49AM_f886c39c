  {
    "funcion": "confirm_association_withdrawal",
    "definicion": "CREATE OR REPLACE FUNCTION public.confirm_association_withdrawal(p_request_id uuid, p_debts_checked boolean, p_materials_checked boolean, p_notes text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_admin_id uuid := auth.uid();\r\n  v_admin_email text := lower(trim(COALESCE(auth.jwt() ->> 'email', '')));\r\n  v_is_admin boolean := false;\r\n  v_req public.membership_withdrawal_requests%ROWTYPE;\r\n  v_email_norm text;\r\n  v_profile_id uuid;\r\n  v_student_id uuid;\r\n  v_teacher_id uuid;\r\n  v_now timestamptz := now();\r\n  v_today date := current_date;\r\n  v_note text;\r\nBEGIN\r\n  SELECT EXISTS (\r\n    SELECT 1\r\n    FROM public.profiles p\r\n    WHERE (p.id = v_admin_id OR (v_admin_email <> '' AND lower(trim(p.email)) = v_admin_email))\r\n      AND COALESCE(p.access, true) = true\r\n      AND p.role = 'Admin'\r\n  ) INTO v_is_admin;\r\n\r\n  IF NOT v_is_admin THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Solo un Administrador activo puede confirmar la baja.');\r\n  END IF;\r\n\r\n  IF COALESCE(p_debts_checked, false) = false OR COALESCE(p_materials_checked, false) = false THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Debes verificar la devolución de material y los pagos al día.');\r\n  END IF;\r\n\r\n  SELECT * INTO v_req\r\n  FROM public.membership_withdrawal_requests\r\n  WHERE id = p_request_id\r\n  FOR UPDATE;\r\n\r\n  IF NOT FOUND OR v_req.status <> 'pending' THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'Solicitud no encontrada o ya procesada.');\r\n  END IF;\r\n\r\n  v_email_norm := lower(trim(COALESCE(v_req.user_email, '')));\r\n  IF v_email_norm = 'cristino.conde@actriskell.org' THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'No se puede dar de baja al Administrador Maestro.');\r\n  END IF;\r\n\r\n  v_note := COALESCE(NULLIF(trim(p_notes), ''), 'Baja de la asociación confirmada por Administración');\r\n\r\n  UPDATE public.membership_withdrawal_requests\r\n  SET status = 'approved',\r\n      debts_checked = true,\r\n      materials_checked = true,\r\n      resolution_notes = NULLIF(trim(p_notes), ''),\r\n      resolved_by = v_admin_id,\r\n      resolved_at = v_now,\r\n      updated_at = v_now\r\n  WHERE id = p_request_id;\r\n\r\n  -- Resolver IDs vinculados (perfil, alumno y monitor)\r\n  SELECT p.id INTO v_profile_id\r\n  FROM public.profiles p\r\n  WHERE p.id = COALESCE(v_req.profile_id, v_req.user_id)\r\n     OR (v_email_norm <> '' AND lower(trim(p.email)) = v_email_norm)\r\n  LIMIT 1;\r\n\r\n  SELECT s.id INTO v_student_id\r\n  FROM public.students s\r\n  WHERE s.id = v_req.student_id\r\n     OR (v_profile_id IS NOT NULL AND s.profile_id = v_profile_id)\r\n     OR (v_email_norm <> '' AND lower(trim(s.email)) = v_email_norm)\r\n  LIMIT 1;\r\n\r\n  SELECT t.id INTO v_teacher_id\r\n  FROM public.teachers t\r\n  WHERE t.id = v_req.teacher_id\r\n     OR (v_email_norm <> '' AND lower(trim(t.email)) = v_email_norm)\r\n  LIMIT 1;\r\n\r\n  -- Desactivar inscripciones activas/pendientes y ficha de alumno\r\n  IF v_student_id IS NOT NULL THEN\r\n    UPDATE public.student_enrollments\r\n    SET active = false,\r\n        status = 'inactive',\r\n        deleted_at = v_now,\r\n        ended_at = v_today,\r\n        drop_debts_checked = true,\r\n        drop_materials_checked = true,\r\n        drop_resolved_by = v_admin_id,\r\n        drop_resolved_at = v_now,\r\n        drop_resolution_notes = NULLIF(trim(p_notes), '')\r\n    WHERE student_id = v_student_id\r\n      AND COALESCE(status, 'active') <> 'inactive';\r\n\r\n    UPDATE public.students\r\n    SET status = 'inactive',\r\n        is_socio = false,\r\n        end_date = v_today\r\n    WHERE id = v_student_id;\r\n\r\n    BEGIN\r\n      UPDATE public.member_status_history\r\n      SET end_date = v_today\r\n      WHERE entity_type = 'student' AND entity_id = v_student_id AND end_date IS NULL;\r\n\r\n      INSERT INTO public.member_status_history (\r\n        entity_type, entity_id, status, start_date, end_date, notes, changed_by\r\n      ) VALUES (\r\n        'student', v_student_id, 'inactive', v_today, v_today, v_note, v_admin_id\r\n      );\r\n    EXCEPTION WHEN undefined_table OR undefined_column THEN\r\n      NULL;\r\n    END;\r\n  END IF;\r\n\r\n  -- Desactivar ficha de monitor si existe\r\n  IF v_teacher_id IS NOT NULL THEN\r\n    UPDATE public.teachers\r\n    SET active = false,\r\n        is_socio = false,\r\n        end_date = v_today\r\n    WHERE id = v_teacher_id;\r\n\r\n    BEGIN\r\n      UPDATE public.member_status_history\r\n      SET end_date = v_today\r\n      WHERE entity_type = 'teacher' AND entity_id = v_teacher_id AND end_date IS NULL;\r\n\r\n      INSERT INTO public.member_status_history (\r\n        entity_type, entity_id, status, start_date, end_date, notes, changed_by\r\n      ) VALUES (\r\n        'teacher', v_teacher_id, 'inactive', v_today, v_today, v_note, v_admin_id\r\n      );\r\n    EXCEPTION WHEN undefined_table OR undefined_column THEN\r\n      NULL;\r\n    END;\r\n  END IF;\r\n\r\n  -- Revocar acceso y membresía en public.profiles\r\n  IF v_profile_id IS NOT NULL THEN\r\n    UPDATE public.profiles\r\n    SET access = false,\r\n        active = false,\r\n        is_socio = false,\r\n        operational_role = 'vacio',\r\n        end_date = v_today\r\n    WHERE id = v_profile_id\r\n      AND lower(trim(COALESCE(email, ''))) <> 'cristino.conde@actriskell.org';\r\n\r\n    BEGIN\r\n      UPDATE public.member_status_history\r\n      SET end_date = v_today\r\n      WHERE entity_type = 'profile' AND entity_id = v_profile_id AND end_date IS NULL;\r\n\r\n      INSERT INTO public.member_status_history (\r\n        entity_type, entity_id, status, start_date, end_date, notes, changed_by\r\n      ) VALUES (\r\n        'profile', v_profile_id, 'inactive', v_today, v_today, v_note, v_admin_id\r\n      );\r\n    EXCEPTION WHEN undefined_table OR undefined_column THEN\r\n      NULL;\r\n    END;\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object(\r\n    'success', true,\r\n    'request_id', p_request_id,\r\n    'profile_id', v_profile_id,\r\n    'student_id', v_student_id,\r\n    'teacher_id', v_teacher_id\r\n  );\r\nEND;\r\n$function$\n"
