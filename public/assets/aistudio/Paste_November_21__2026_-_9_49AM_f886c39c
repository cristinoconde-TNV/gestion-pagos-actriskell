  {
    "funcion": "guard_profiles_role_and_links",
    "definicion": "CREATE OR REPLACE FUNCTION public.guard_profiles_role_and_links()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  is_service boolean;\r\n  is_self_promotion boolean;\r\nBEGIN\r\n  is_service := current_user IN ('postgres', 'supabase_admin', 'service_role')\r\n    OR COALESCE(current_setting('request.jwt.claim.role', true), '') = 'service_role';\r\n\r\n  IF is_service OR public.is_admin_user() THEN\r\n    RETURN NEW;\r\n  END IF;\r\n\r\n  is_self_promotion := (\r\n    auth.uid() = OLD.id\r\n    AND OLD.role IN ('socio', 'student', 'teacher', 'teacher_student')\r\n    AND NEW.role IN ('socio', 'student', 'teacher', 'teacher_student')\r\n    AND NEW.role <> 'admin'\r\n  );\r\n\r\n  IF (\r\n    NEW.role IS DISTINCT FROM OLD.role AND NOT is_self_promotion\r\n  ) OR (\r\n    (NEW.teacher_id IS DISTINCT FROM OLD.teacher_id OR NEW.student_id IS DISTINCT FROM OLD.student_id)\r\n    AND NOT is_self_promotion\r\n  ) THEN\r\n    RAISE EXCEPTION 'Solo la administración puede modificar el rol o los vínculos de perfil.';\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "guard_profiles_soft_delete",
    "definicion": "CREATE OR REPLACE FUNCTION public.guard_profiles_soft_delete()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nBEGIN\r\n  IF TG_OP = 'DELETE' THEN\r\n    RAISE EXCEPTION 'No se permite eliminar perfiles directamente; utiliza baja lógica (active = false).';\r\n  END IF;\r\n\r\n  IF TG_OP = 'UPDATE' THEN\r\n    IF LOWER(OLD.email) = 'cristino.conde@actriskell.org' AND NEW.active IS FALSE THEN\r\n      RAISE EXCEPTION 'No se puede dar de baja al administrador principal.';\r\n    END IF;\r\n\r\n    -- Solo un administrador activo puede cambiar active, role, teacher_id, student_id o fechas de baja\r\n    IF NOT public.is_admin_user() THEN\r\n      IF NEW.active IS DISTINCT FROM OLD.active\r\n         OR NEW.role IS DISTINCT FROM OLD.role\r\n         OR NEW.teacher_id IS DISTINCT FROM OLD.teacher_id\r\n         OR NEW.student_id IS DISTINCT FROM OLD.student_id\r\n         OR NEW.end_date IS DISTINCT FROM OLD.end_date THEN\r\n        RAISE EXCEPTION 'Solo la administración puede modificar el estado de acceso, rol o vínculos.';\r\n      END IF;\r\n    END IF;\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
  },
  {
    "funcion": "handle_new_auth_user",
    "definicion": "CREATE OR REPLACE FUNCTION public.handle_new_auth_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  assigned_role TEXT := 'student';\r\n  linked_teacher_id UUID := NULL;\r\n  linked_student_id UUID := NULL;\r\n  user_full_name TEXT;\r\n  normalized_email TEXT := lower(trim(NEW.email));\r\n  requested_role TEXT := NEW.raw_user_meta_data ->> 'role';\r\nBEGIN\r\n  -- Detect existing teacher or student record by email\r\n  SELECT id INTO linked_teacher_id\r\n  FROM public.teachers\r\n  WHERE lower(trim(email)) = normalized_email\r\n  LIMIT 1;\r\n\r\n  SELECT id INTO linked_student_id\r\n  FROM public.students\r\n  WHERE lower(trim(email)) = normalized_email\r\n  LIMIT 1;\r\n\r\n  -- Assign safe initial role\r\n  IF normalized_email = 'cristino.conde@actriskell.org' THEN\r\n    assigned_role := 'admin';\r\n  ELSIF requested_role IN ('teacher', 'student', 'teacher_student') THEN\r\n    assigned_role := requested_role;\r\n  ELSIF linked_teacher_id IS NOT NULL AND linked_student_id IS NOT NULL THEN\r\n    assigned_role := 'teacher_student';\r\n  ELSIF linked_teacher_id IS NOT NULL THEN\r\n    assigned_role := 'teacher';\r\n  ELSE\r\n    assigned_role := 'student';\r\n  END IF;\r\n\r\n  user_full_name := COALESCE(\r\n    NULLIF(trim(NEW.raw_user_meta_data ->> 'full_name'), ''),\r\n    NULLIF(trim(NEW.raw_user_meta_data ->> 'name'), ''),\r\n    split_part(normalized_email, '@', 1)\r\n  );\r\n\r\n  INSERT INTO public.profiles (\r\n    id,\r\n    email,\r\n    full_name,\r\n    avatar_url,\r\n    role,\r\n    teacher_id,\r\n    student_id\r\n  ) VALUES (\r\n    NEW.id,\r\n    normalized_email,\r\n    user_full_name,\r\n    COALESCE(NEW.raw_user_meta_data ->> 'avatar_url', NEW.raw_user_meta_data ->> 'picture'),\r\n    assigned_role,\r\n    linked_teacher_id,\r\n    linked_student_id\r\n  )\r\n  ON CONFLICT (id) DO UPDATE SET\r\n    email = EXCLUDED.email,\r\n    full_name = EXCLUDED.full_name,\r\n    avatar_url = COALESCE(EXCLUDED.avatar_url, public.profiles.avatar_url),\r\n    teacher_id = COALESCE(EXCLUDED.teacher_id, public.profiles.teacher_id),\r\n    student_id = COALESCE(EXCLUDED.student_id, public.profiles.student_id);\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
