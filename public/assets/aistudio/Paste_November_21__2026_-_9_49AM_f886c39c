    "definicion": "CREATE OR REPLACE FUNCTION public.is_own_student_record(p_student_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT EXISTS (\r\n    SELECT 1\r\n    FROM public.profiles p\r\n    JOIN public.students s ON s.id = p_student_id\r\n    WHERE p.id = auth.uid()\r\n      AND COALESCE(p.active, TRUE) = TRUE\r\n      AND (\r\n        p.student_id = s.id\r\n        OR s.profile_id = p.id\r\n        OR LOWER(TRIM(COALESCE(s.email, ''))) = LOWER(TRIM(COALESCE(p.email, '')))\r\n      )\r\n  );\r\n$function$\n"
