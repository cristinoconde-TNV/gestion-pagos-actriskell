    "definicion": "CREATE OR REPLACE FUNCTION public.trg_fn_students_auto_sync()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nBEGIN\r\n  IF pg_trigger_depth() > 1 THEN RETURN NULL; END IF;\r\n  IF NEW.is_socio IS DISTINCT FROM OLD.is_socio THEN\r\n    UPDATE public.profiles\r\n    SET is_socio = NEW.is_socio\r\n    WHERE student_id = NEW.id\r\n       OR (NEW.profile_id IS NOT NULL AND id = NEW.profile_id)\r\n       OR (coalesce(trim(NEW.email), '') <> '' AND lower(trim(email)) = lower(trim(NEW.email)));\r\n  END IF;\r\n  PERFORM public.trg_sync_profiles_for_student(NEW.id);\r\n  RETURN NULL;\r\nEND;\r\n$function$\n"
