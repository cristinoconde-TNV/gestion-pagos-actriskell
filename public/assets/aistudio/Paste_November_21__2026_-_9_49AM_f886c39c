    "funcion": "cancel_activity_unenrollment_request",
    "definicion": "CREATE OR REPLACE FUNCTION public.cancel_activity_unenrollment_request(p_activity_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_uid UUID := auth.uid();\r\n  v_student_id UUID;\r\n  v_updated_id UUID;\r\nBEGIN\r\n  IF v_uid IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'No hay sesión autenticada.');\r\n  END IF;\r\n\r\n  SELECT s.id INTO v_student_id\r\n  FROM public.profiles p\r\n  JOIN public.students s\r\n    ON s.id = p.student_id\r\n    OR s.profile_id = p.id\r\n    OR lower(trim(coalesce(s.email, ''))) = lower(trim(coalesce(p.email, '')))\r\n  WHERE p.id = v_uid\r\n    AND p.active IS DISTINCT FROM FALSE\r\n  LIMIT 1;\r\n\r\n  IF v_student_id IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'No se encontró la ficha de alumno vinculada.');\r\n  END IF;\r\n\r\n  UPDATE public.student_enrollments\r\n  SET status = 'active',\r\n      drop_requested_at = NULL,\r\n      drop_reason = NULL\r\n  WHERE student_id = v_student_id\r\n    AND activity_id = p_activity_id\r\n    AND status = 'pending_unenroll'\r\n  RETURNING id INTO v_updated_id;\r\n\r\n  IF v_updated_id IS NULL THEN\r\n    RETURN jsonb_build_object('success', false, 'error', 'No hay una solicitud de baja pendiente para cancelar.');\r\n  END IF;\r\n\r\n  RETURN jsonb_build_object('success', true, 'enrollment_id', v_updated_id);\r\nEND;\r\n$function$\n"
