  {
    "funcion": "handle_new_user",
    "definicion": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v_email text;\r\n  v_raw_role text;\r\n  v_role text;\r\n  v_is_socio boolean;\r\n  v_access boolean;\r\nBEGIN\r\n  v_email := lower(trim(COALESCE(NEW.email, '')));\r\n  v_raw_role := lower(trim(COALESCE(NEW.raw_user_meta_data->>'role', '')));\r\n\r\n  v_role := CASE v_raw_role\r\n    WHEN 'admin' THEN 'admin'\r\n    WHEN 'administrador' THEN 'admin'\r\n    WHEN 'monitor' THEN 'teacher'\r\n    WHEN 'teacher' THEN 'teacher'\r\n    WHEN 'profesor' THEN 'teacher'\r\n    WHEN 'alumno' THEN 'student'\r\n    WHEN 'student' THEN 'student'\r\n    WHEN 'híbrido' THEN 'hybrid'\r\n    WHEN 'hibrido' THEN 'hybrid'\r\n    WHEN 'hybrid' THEN 'hybrid'\r\n    WHEN 'teacher_student' THEN 'hybrid'\r\n    ELSE 'member'\r\n  END;\r\n\r\n  IF v_email = 'cristino.conde@actriskell.org' THEN\r\n    v_role := 'admin';\r\n    v_access := true;\r\n    v_is_socio := COALESCE((NEW.raw_user_meta_data->>'is_socio')::boolean, true);\r\n  ELSE\r\n    v_access := COALESCE((NEW.raw_user_meta_data->>'access')::boolean, false);\r\n    v_is_socio := COALESCE((NEW.raw_user_meta_data->>'is_socio')::boolean, false);\r\n  END IF;\r\n\r\n  INSERT INTO public.profiles (\r\n    id, email, full_name, role, access, active, is_socio, member_type, start_date\r\n  )\r\n  VALUES (\r\n    NEW.id,\r\n    NEW.email,\r\n    COALESCE(NEW.raw_user_meta_data->>'full_name', split_part(COALESCE(NEW.email, ''), '@', 1), 'Usuario'),\r\n    v_role,\r\n    v_access,\r\n    v_access,\r\n    v_is_socio,\r\n    CASE\r\n      WHEN v_is_socio THEN 'socio'\r\n      WHEN v_role IN ('teacher', 'hybrid') THEN 'monitor_no_socio'\r\n      ELSE 'alumno_no_socio'\r\n    END,\r\n    CURRENT_DATE\r\n  )\r\n  ON CONFLICT (id) DO UPDATE SET\r\n    email = EXCLUDED.email,\r\n    role = COALESCE(public.profiles.role, EXCLUDED.role),\r\n    access = COALESCE(public.profiles.access, EXCLUDED.access),\r\n    active = COALESCE(public.profiles.active, EXCLUDED.active),\r\n    is_socio = COALESCE(public.profiles.is_socio, EXCLUDED.is_socio);\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
